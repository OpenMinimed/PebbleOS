excludes = []
if not bld.env.CONFIG_GH3X2X_TUNING_SERVICE_ENABLED:
    excludes.extend(['gh3x2x_tuning_service.c'])
if not bld.env.CONFIG_MINIMED_SAKE:
    excludes.extend(['minimed_sake_service.c', 'minimed_sake_read.c'])

driver_source = bld.path.ant_glob(['*.c'], excl=excludes)

driver_use = [
    'nimble',
    'freertos',
    'fw_includes',
    'pbl_includes',
]
if bld.env.CONFIG_MINIMED_SAKE:
    driver_use.append('minimed_includes')  # src/fw/services/minimed

bld.objects(
    source=driver_source,
    target='bt_driver',
    use=driver_use,
)

